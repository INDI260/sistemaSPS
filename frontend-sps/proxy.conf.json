{
  "/api/auth/*": {
    "target": "http://localhost:8081",
    "pathRewrite": { "^/api/auth": "/ws/auth" },
    "secure": false,
    "logLevel": "debug"
  },
  "/api/compra/*": {
    "target": "http://localhost:8082",
    "pathRewrite": { "^/api/compra": "/ws/compra" },
    "secure": false,
    "logLevel": "debug"
  }
}
