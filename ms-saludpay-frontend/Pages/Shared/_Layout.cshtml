<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SaludPay - @ViewData["Title"]</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; background: #f5f5f5; color: #333; }
        .navbar { background: #1a73e8; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .navbar h1 { font-size: 1.4rem; }
        .navbar a { color: white; text-decoration: none; margin-left: 1rem; }
        .container { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
        .card { background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); padding: 2rem; margin-bottom: 1.5rem; }
        .btn { display: inline-block; padding: .6rem 1.4rem; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; text-decoration: none; }
        .btn-primary { background: #1a73e8; color: white; }
        .btn-primary:hover { background: #1558b0; }
        .btn-success { background: #34a853; color: white; }
        .btn-success:hover { background: #2a8542; }
        .alert { padding: .75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
        .alert-danger { background: #fde8e8; color: #b00020; border: 1px solid #f5c6cb; }
        .alert-success { background: #e6f4ea; color: #137333; border: 1px solid #b7dfb9; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .75rem 1rem; text-align: left; border-bottom: 1px solid #e0e0e0; }
        th { background: #f8f9fa; font-weight: 600; }
        tr:last-child td { border-bottom: none; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: .4rem; font-weight: 500; }
        input[type=text], input[type=password] { width: 100%; padding: .6rem .8rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
        input:focus { outline: none; border-color: #1a73e8; }
    </style>
</head>
<body>
    <nav class="navbar">
        <h1>SaludPay</h1>
        <div>
            @if (Context.Session.GetString("token") != null)
            {
                <span>@Context.Session.GetString("cedula")</span>
                <a href="/Login?handler=Logout">Cerrar sesión</a>
            }
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
